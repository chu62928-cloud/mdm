--- /dev/null
+++ b/new/run_knee_eval.sh
@@ -0,0 +1,113 @@
+#!/usr/bin/env bash
+# new/run_knee_eval.sh
+#
+# 膝超伸专项评估：V2_dps_s40_always vs V6_closed_loop_second_half
+# 支持三种 TEXT_PROMPT 模式，验证 OOD 假说
+#
+# 用法:
+#   bash new/run_knee_eval.sh [PROMPT_MODE] [N_SEEDS]
+#
+#   PROMPT_MODE:
+#     walk  = "a person is walking forward"
+#             → 原始 OOD 场景，预期 Δ≈0, hit=0%（复现之前失败）
+#     stand = "a person stands still with stiff straight legs"
+#             → SEED=42 单次已验证 hit=100%，此模式跑 N=5 确认稳定性
+#             → ⚠ corr 无意义（baseline 静止，分母≈0）
+#     slow  = "a person walks very slowly with knees slightly stiff"
+#             → 有时序结构 → corr 可读；先验不那么强 → 期望仍有推力
+#
+#   N_SEEDS 默认 5（候选: 7 42 99 123 2024）
+#
+# 示例:
+#   bash new/run_knee_eval.sh stand 5   # 推力稳定性验证
+#   bash new/run_knee_eval.sh slow  5   # corr 有效性验证
+#   bash new/run_knee_eval.sh walk  5   # OOD 失败基线（对照）
+#
+# 聚合:
+#   python -m new.aggregate_seeds ./output/knee_eval_stand_*
+#   python -m new.aggregate_seeds ./output/knee_eval_slow_*
+#   python -m new.aggregate_seeds ./output/knee_eval_walk_*
+
+set -e
+
+PROMPT_MODE="${1:-stand}"
+N_SEEDS="${2:-5}"
+
+case "$PROMPT_MODE" in
+    walk)
+        TEXT_PROMPT="a person is walking forward"
+        PROMPT_TAG="walk"
+        ;;
+    stand)
+        TEXT_PROMPT="a person stands still with stiff straight legs"
+        PROMPT_TAG="stand"
+        ;;
+    slow)
+        TEXT_PROMPT="a person walks very slowly with knees slightly stiff"
+        PROMPT_TAG="slow"
+        ;;
+    *)
+        echo "未知 PROMPT_MODE='$PROMPT_MODE'。可选: walk | stand | slow"
+        exit 1
+        ;;
+esac
+
+ALL_SEEDS=(7 42 99 123 2024 17 23 88 251 333)
+SEEDS=("${ALL_SEEDS[@]:0:$N_SEEDS}")
+
+POSTURE="膝超伸"
+MOTION_LENGTH="${MOTION_LENGTH:-6.0}"
+HUBER_DELTA="0.05"
+
+V2_KWARGS='{"s":40.0,"schedule":"always","base_weight":1.0}'
+V6_KWARGS="{\"Kp\":80,\"Ki\":1,\"Kd\":5,\"s_min\":0.05,\"s_max\":50,\
+\"I_max\":20,\"beta_ema\":0.8,\"lambda_smooth\":0.03,\
+\"manifold_project\":true,\"loss_form\":\"huber\",\
+\"huber_delta\":${HUBER_DELTA},\"normalize_grad\":false,\
+\"band_gate\":false,\"spec_schedule_override\":\"second_half\"}"
+
+declare -A VARIANTS=(
+    ["v2_dps_s40_always"]="v2_dps|${V2_KWARGS}"
+    ["v6_closed_loop_second_half"]="v6_closed_loop|${V6_KWARGS}"
+)
+
+echo ""
+echo "================================================="
+echo "  膝超伸专项评估（V2 vs V6，N=${N_SEEDS}）"
+echo "  PROMPT_MODE  = ${PROMPT_MODE}"
+echo "  TEXT_PROMPT  = ${TEXT_PROMPT}"
+echo "  seeds        = ${SEEDS[*]}"
+echo "================================================="
+echo ""
+
+if [ "$PROMPT_MODE" = "stand" ]; then
+    echo "⚠  stand 模式：baseline 接近静止，corr 数值无意义，只看 Δ 和 hit_band。"
+    echo ""
+fi
+
+for CONFIG_NAME in "${!VARIANTS[@]}"; do
+    CONFIG="${VARIANTS[$CONFIG_NAME]}"
+    VARIANT="${CONFIG%%|*}"
+    KWARGS="${CONFIG##*|}"
+
+    OUT_BASE="./output/knee_eval_${PROMPT_TAG}_${CONFIG_NAME}"
+    mkdir -p "${OUT_BASE}"
+
+    echo "-- variant: ${CONFIG_NAME}"
+    echo "   out: ${OUT_BASE}"
+
+    for SEED in "${SEEDS[@]}"; do
+        SEED_OUT="${OUT_BASE}/seed${SEED}"
+        if [ -f "${SEED_OUT}/comparison.npy" ]; then
+            echo "   seed=${SEED} CACHED, skip"
+            continue
+        fi
+        echo "   seed=${SEED}..."
+        GUIDANCE_VARIANT="${VARIANT}" \
+        GUIDANCE_KWARGS_JSON="${KWARGS}" \
+        TEXT_PROMPT="${TEXT_PROMPT}" \
+        POSTURE="${POSTURE}" \
+        SEED="${SEED}" \
+        MOTION_LENGTH="${MOTION_LENGTH}" \
+        OUTPUT_DIR="${SEED_OUT}" \
+        MAKE_ANIMATION="" \
+        MAKE_MULTIVIEW="" \
+        MAKE_ANATOMICAL="" \
+        bash new/run_posture_pipeline.sh
+    done
+    echo ""
+done
+
+echo "================================================="
+echo "  评估完成。聚合："
+echo "    python -m new.aggregate_seeds ./output/knee_eval_${PROMPT_TAG}_*"
+echo ""
+echo "  三种 prompt 全部跑完后横向对比："
+echo "    python -m new.aggregate_seeds ./output/knee_eval_walk_*   # OOD基线"
+echo "    python -m new.aggregate_seeds ./output/knee_eval_stand_*  # 推力验证"
+echo "    python -m new.aggregate_seeds ./output/knee_eval_slow_*   # corr可读"
+echo "================================================="
